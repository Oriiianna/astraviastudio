# Mailtrap — credenciales del formulario de contacto.

# Token de API (obtenido en API Tokens)
MAILTRAP_API_TOKEN=

# --- Modo Sandbox (pruebas) ---------------------------------------------
# Dejar vacío para envío real en producción.
MAILTRAP_INBOX_ID=

# --- Envío real (Email Sending) -----------------------------------------
# Obligatoria: sin esta, api/contact.js responde 500 (no hay fallback hardcodeado).
# Remitente con dominio verificado en Mailtrap
MAILTRAP_FROM_EMAIL=

# Obligatoria: sin esta, api/contact.js responde 500 (no hay fallback hardcodeado).
# Casilla de destino donde la agencia recibirá las consultas del formulario
MAILTRAP_TO_EMAIL=studioastravia@gmail.com
# Cloudflare Turnstile (anti-bots del formulario).
# Clave SECRETA: solo en el servidor (acá y en las variables de entorno de Vercel).
# En producción es obligatoria; sin ella api/contact.js responde 500.
# Fuera de producción, si falta, se omite la verificación.
# Para pruebas locales con el sitio en localhost, claves de prueba de Cloudflare:
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
#   VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=
# Opcional: la site key pública ya viene en el código; esto solo la reemplaza.
VITE_TURNSTILE_SITE_KEY=

# Opcional: token de Cloudflare Web Analytics (Cloudflare → Web Analytics → Add a site).
# Sin token no se carga la analítica.
VITE_CF_BEACON_TOKEN=

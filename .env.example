# Mailtrap — credenciales del formulario de contacto.
# Copiá este archivo como .env (no se commitea) y cargá los mismos valores en
# Vercel → Settings → Environment Variables.

# Token de API. Mailtrap → Settings → API Tokens.
# Para Sandbox alcanza un token con permiso sobre el proyecto;
# para envío real necesita el scope "Sending".
MAILTRAP_API_TOKEN=

# --- Modo Sandbox (pruebas) ---------------------------------------------
# Con MAILTRAP_INBOX_ID cargado, el mail NO se entrega: queda en la bandeja
# virtual de Mailtrap (Email Testing → tu inbox → la URL termina en /inboxes/<id>).
# Ideal para probar sin ensuciar el correo real. Dejalo VACÍO para envío real.
MAILTRAP_INBOX_ID=

# --- Envío real (Email Sending) -----------------------------------------
# El remitente tiene que estar en un dominio verificado en Mailtrap.
# Mientras el dominio propio no esté verificado, se puede usar el dominio
# demo de la cuenta (algo como formulario@demomailtrap.co), que sólo entrega
# al email del dueño de la cuenta.
MAILTRAP_FROM_EMAIL=formulario@astravia.digital

# Casilla que recibe las consultas.
MAILTRAP_TO_EMAIL=studioastravia@gmail.com
